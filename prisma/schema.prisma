generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model academic_years {
  id                   String                 @id @default(cuid())
  schoolId             String
  name                 String
  startDate            DateTime
  endDate              DateTime
  isCurrent            Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  schools              schools                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student_enrollments  student_enrollments[]
  fee_structures       fee_structures[]
  student_fee_invoices student_fee_invoices[]
  exams                exams[]
  class_timetables     class_timetables[]
  transport_allocations student_transport_allocations[]

  @@index([schoolId])
}

model classes {
  id                  String                @id @default(cuid())
  schoolId            String
  name                String
  order               Int                   @default(1)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  schools             schools               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections            sections[]
  student_enrollments student_enrollments[]
  class_subjects      class_subjects[]
  student_attendance  student_attendance[]
  fee_structures      fee_structures[]
  exam_schedules      exam_schedules[]
  exam_results        exam_results[]
  class_timetables    class_timetables[]
  homework            homework[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model class_subjects {
  id        String    @id @default(cuid())
  schoolId  String
  classId   String
  subjectId String
  teacherId String?
  createdAt DateTime  @default(now())
  classes   classes   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjects  subjects  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teachers  teachers? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([classId, subjectId])
  @@index([schoolId])
}

model parent_students {
  id        String   @id @default(cuid())
  parentId  String
  studentId String
  relation  String?  // e.g. "FATHER", "MOTHER", "GUARDIAN"
  isPrimary Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  parents   parents  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  students  students @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentId])
}

model parents {
  id               String            @id @default(cuid())
  schoolId         String
  userId           String?           @unique
  firstName        String
  lastName         String
  phone            String
  email            String?
  address          String?
  occupation       String?
  emergencyContact Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  parent_students  parent_students[]
  portal_invitations portal_invitations[]
  schools          schools           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  users            users?            @relation(fields: [userId], references: [id])

  @@index([schoolId])
}

model schools {
  id                   String                 @id @default(cuid())
  name                 String
  code                 String                 @unique
  email                String
  phone                String?
  logo                 String?
  address              String?
  city                 String?
  state                String?
  country              String?
  status               SchoolStatus           @default(ACTIVE)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  academic_years       academic_years[]
  classes              classes[]
  parents              parents[]
  sections             sections[]
  student_enrollments  student_enrollments[]
  students             students[]
  subjects             subjects[]
  teachers             teachers[]
  users                users[]
  documents            documents[]
  audit_logs           audit_logs[]
  student_attendance   student_attendance[]
  staff_attendance     staff_attendance[]
  fee_categories       fee_categories[]
  fee_structures       fee_structures[]
  student_fee_invoices student_fee_invoices[]
  fee_payments         fee_payments[]
  grading_scales       grading_scales[]
  exams                exams[]
  exam_schedules       exam_schedules[]
  exam_marks           exam_marks[]
  exam_results         exam_results[]
  class_timetables     class_timetables[]
  homework             homework[]
  homework_submissions homework_submissions[]
  vehicles                     vehicles[]
  transport_routes             transport_routes[]
  transport_stops              transport_stops[]
  drivers                      drivers[]
  vehicle_assignments          vehicle_assignments[]
  student_transport_allocations student_transport_allocations[]
  library_settings             library_settings?
  library_categories           library_categories[]
  library_authors              library_authors[]
  library_publishers           library_publishers[]
  library_books                library_books[]
  library_book_copies          library_book_copies[]
  library_members              library_members[]
  library_issues               library_issues[]
  library_fines                library_fines[]
  library_reservations         library_reservations[]
  inventory_categories         inventory_categories[]
  inventory_locations          inventory_locations[]
  inventory_suppliers          inventory_suppliers[]
  inventory_items              inventory_items[]
  inventory_stock_movements    inventory_stock_movements[]
  inventory_stock_transfers    inventory_stock_transfers[]
  inventory_assets             inventory_assets[]
  inventory_asset_assignments  inventory_asset_assignments[]
  inventory_depreciations      inventory_depreciations[]
  inventory_maintenance_tickets inventory_maintenance_tickets[]
  inventory_purchase_orders    inventory_purchase_orders[]
  portal_settings              portal_settings?
  portal_invitations           portal_invitations[]
  announcements                announcements[]
  notifications                notifications[]
  notification_recipients      notification_recipients[]
  notification_templates       notification_templates[]
  notification_preferences     notification_preferences[]
  notification_deliveries      notification_deliveries[]
  notification_settings        notification_settings?
  departments                  departments[]
  designations                 designations[]
  employee_profiles            employee_profiles[]
  employee_documents           employee_documents[]
  leave_types                  leave_types[]
  leave_balances               leave_balances[]
  leave_applications           leave_applications[]
  salary_structures            salary_structures[]
  employee_salary_assignments  employee_salary_assignments[]
  payroll_periods              payroll_periods[]
  payroll_records              payroll_records[]
  payroll_adjustments          payroll_adjustments[]
  payslips                     payslips[]
  expense_categories           expense_categories[]
  expenses                     expenses[]
  school_subscriptions         school_subscriptions?
  subscription_history         subscription_history[]
  billing_addresses            billing_addresses?
  billing_invoices             billing_invoices[]
  billing_payments             billing_payments[]
  coupon_redemptions           coupon_redemptions[]
  payment_attempts             payment_attempts[]
  credit_notes                 credit_notes[]
}

model sections {
  id                  String                @id @default(cuid())
  schoolId            String
  classId             String
  name                String
  capacity            Int                   @default(40)
  classTeacherId      String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  classes             classes               @relation(fields: [classId], references: [id], onDelete: Cascade)
  schools             schools               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classTeacher        teachers?             @relation(fields: [classTeacherId], references: [id], onDelete: SetNull)
  student_enrollments student_enrollments[]
  student_attendance  student_attendance[]
  exam_schedules      exam_schedules[]
  exam_results        exam_results[]
  class_timetables    class_timetables[]
  homework            homework[]

  @@unique([classId, name])
  @@index([schoolId])
}

model student_enrollments {
  id             String           @id @default(cuid())
  schoolId       String
  studentId      String
  academicYearId String
  classId        String
  sectionId      String
  rollNumber     String?
  status         EnrollmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  academic_years academic_years   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classes        classes          @relation(fields: [classId], references: [id], onDelete: Cascade)
  schools        schools          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections       sections         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  students       students         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId])
  @@index([academicYearId])
  @@index([schoolId])
  @@index([classId])
}

model students {
  id                   String                 @id @default(cuid())
  schoolId             String
  userId               String?                @unique
  admissionNumber      String
  firstName            String
  lastName             String
  dateOfBirth          DateTime?
  gender               Gender?
  phone                String?
  email                String?
  address              String?
  photo                String?
  bloodGroup           String?
  emergencyContact     String?
  admissionDate        DateTime               @default(now())
  status               UserStatus             @default(ACTIVE)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  parent_students      parent_students[]
  student_enrollments  student_enrollments[]
  documents            documents[]
  student_attendance   student_attendance[]
  student_fee_invoices student_fee_invoices[]
  exam_marks           exam_marks[]
  exam_results         exam_results[]
  homework_submissions homework_submissions[]
  transport_allocations student_transport_allocations[]
  library_members      library_members[]
  portal_invitations   portal_invitations[]
  schools              schools                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  users                users?                 @relation(fields: [userId], references: [id])

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
}

model subjects {
  id             String           @id @default(cuid())
  schoolId       String
  name           String
  code           String
  description    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  schools        schools          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class_subjects class_subjects[]
  exam_schedules exam_schedules[]
  class_timetables class_timetables[]
  homework       homework[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model teachers {
  id               String             @id @default(cuid())
  schoolId         String
  userId           String             @unique
  employeeId       String
  firstName        String
  lastName         String
  phone            String?
  email            String
  photo            String?
  qualification    String?
  department       String?
  designation      String?
  joiningDate      DateTime           @default(now())
  status           UserStatus         @default(ACTIVE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  sections         sections[]
  class_subjects   class_subjects[]
  documents        documents[]
  staff_attendance staff_attendance[]
  invigilated_schedules exam_schedules[]   @relation("TeacherExamInvigilation")
  timetables            class_timetables[] @relation("TeacherTimetable")
  assigned_homework     homework[]         @relation("TeacherHomework")
  library_members       library_members[]
  inventory_asset_assignments inventory_asset_assignments[]
  employee_profiles    employee_profiles?
  headed_departments   departments[]      @relation("DepartmentHead")
  schools          schools            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  users            users              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, employeeId])
  @@index([schoolId])
}

model users {
  id                        String               @id @default(cuid())
  schoolId                  String?
  name                      String
  email                     String               @unique
  passwordHash              String
  role                      Role
  status                    UserStatus           @default(ACTIVE)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  parents                   parents?
  students                  students?
  teachers                  teachers?
  refresh_tokens            refresh_tokens[]
  audit_logs                audit_logs[]
  marked_student_attendance student_attendance[] @relation("UserStudentAttendance")
  marked_staff_attendance   staff_attendance[]   @relation("UserStaffAttendance")
  recorded_fee_payments     fee_payments[]       @relation("UserFeePayments")
  graded_exam_marks         exam_marks[]         @relation("UserExamMarks")
  approved_exam_results     exam_results[]       @relation("UserExamResultsApproved")
  evaluated_homework        homework_submissions[] @relation("UserHomeworkEvaluated")
  library_members           library_members[]
  issued_library_books      library_issues[]       @relation("IssuedByUser")
  received_library_books    library_issues[]       @relation("ReceivedByUser")
  waived_library_fines      library_fines[]        @relation("FineWaivedByUser")
  library_fine_adjustments  library_fine_adjustments[]
  inventory_asset_assignments inventory_asset_assignments[]
  inventory_stock_movements   inventory_stock_movements[]
  notification_recipients     notification_recipients[]
  notification_preferences    notification_preferences[]
  notification_deliveries     notification_deliveries[]
  leave_approvals             leave_applications[]   @relation("LeaveApprover")
  finalized_payroll_periods   payroll_periods[]      @relation("PayrollPeriodFinalizer")
  payroll_adjustments         payroll_adjustments[]  @relation("PayrollAdjuster")
  created_expenses            expenses[]             @relation("ExpenseCreator")
  approved_expenses           expenses[]             @relation("ExpenseApprover")
  expense_step_approvals      expense_approvals[]    @relation("ExpenseStepApprover")
  issued_credit_notes         credit_notes[]         @relation("CreditNoteIssuer")
  schools                   schools?             @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([role])
  @@index([schoolId])
}

model refresh_tokens {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model documents {
  id        String    @id @default(cuid())
  schoolId  String
  studentId String?
  teacherId String?
  name      String
  type      String    // e.g. "BIRTH_CERTIFICATE", "TRANSFER_CERTIFICATE", "ID_PROOF", "RESUME", "TRANSCRIPT"
  fileUrl   String
  fileSize  Int
  mimeType  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  schools   schools   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students  students? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teachers  teachers? @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([studentId])
  @@index([teacherId])
}

model audit_logs {
  id         String   @id @default(cuid())
  schoolId   String?
  userId     String?
  action     String   // e.g. "STUDENT_ENROLLED", "FEE_PAID", "ATTENDANCE_MARKED", etc.
  resource   String   // e.g. "students", "teachers", "attendance", "fees"
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  schools    schools? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  users      users?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([userId])
  @@index([createdAt])
}

// ==========================================
// PHASE 3 MODELS: ATTENDANCE & FEES
// ==========================================

model student_attendance {
  id         String           @id @default(cuid())
  schoolId   String
  studentId  String
  classId    String
  sectionId  String
  date       DateTime
  status     AttendanceStatus @default(PRESENT)
  remarks    String?
  markedById String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  schools    schools          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students   students         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classes    classes          @relation(fields: [classId], references: [id], onDelete: Cascade)
  sections   sections         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  markedBy   users?           @relation("UserStudentAttendance", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([studentId, date])
  @@index([schoolId, date])
  @@index([classId, sectionId, date])
}

model staff_attendance {
  id           String           @id @default(cuid())
  schoolId     String
  teacherId    String
  date         DateTime
  status       AttendanceStatus @default(PRESENT)
  checkInTime  DateTime?
  checkOutTime DateTime?
  remarks      String?
  markedById   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  schools      schools          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teachers     teachers         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  markedBy     users?           @relation("UserStaffAttendance", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([teacherId, date])
  @@index([schoolId, date])
}

model fee_categories {
  id             String           @id @default(cuid())
  schoolId       String
  name           String
  description    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  schools        schools          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  fee_structures fee_structures[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model fee_structures {
  id                   String                 @id @default(cuid())
  schoolId             String
  categoryId           String
  classId              String?
  academicYearId       String
  name                 String
  amount               Decimal                @db.Decimal(10, 2)
  frequency            FeeFrequency           @default(MONTHLY)
  dueDate              DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  schools              schools                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  fee_categories       fee_categories         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  classes              classes?               @relation(fields: [classId], references: [id], onDelete: Cascade)
  academic_years       academic_years         @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  student_fee_invoices student_fee_invoices[]

  @@index([schoolId, academicYearId])
  @@index([classId])
}

model student_fee_invoices {
  id             String          @id @default(cuid())
  schoolId       String
  invoiceNumber  String
  studentId      String
  feeStructureId String?
  academicYearId String
  title          String
  baseAmount     Decimal         @db.Decimal(10, 2)
  discount       Decimal         @default(0.00) @db.Decimal(10, 2)
  discountReason String?
  lateFee        Decimal         @default(0.00) @db.Decimal(10, 2)
  totalAmount    Decimal         @db.Decimal(10, 2)
  paidAmount     Decimal         @default(0.00) @db.Decimal(10, 2)
  balance        Decimal         @db.Decimal(10, 2)
  status         InvoiceStatus   @default(PENDING)
  dueDate        DateTime
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  schools        schools         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students       students        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fee_structures fee_structures? @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  academic_years academic_years  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  fee_payments   fee_payments[]
  transport_allocations student_transport_allocations[]
  library_fines        library_fines[]

  @@unique([schoolId, invoiceNumber])
  @@index([schoolId, studentId])
  @@index([schoolId, status])
  @@index([academicYearId])
}

model fee_payments {
  id                   String               @id @default(cuid())
  schoolId             String
  invoiceId            String
  receiptNumber        String
  amount               Decimal              @db.Decimal(10, 2)
  paymentType          PaymentType          @default(PAYMENT)
  paymentMethod        PaymentMethod        @default(CASH)
  transactionReference String?
  remarks              String?
  paymentDate          DateTime             @default(now())
  recordedById         String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  schools              schools              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student_fee_invoices student_fee_invoices @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy           users?               @relation("UserFeePayments", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([schoolId, receiptNumber])
  @@index([schoolId, invoiceId])
  @@index([schoolId, paymentDate])
}

// ==========================================
// ENUMS
// ==========================================

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EnrollmentStatus {
  ACTIVE
  PROMOTED
  GRADUATED
  TRANSFERRED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
}

enum FeeFrequency {
  ONE_TIME
  MONTHLY
  TERM
  ANNUAL
}

enum InvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
  CHEQUE
}

enum PaymentType {
  PAYMENT
  REFUND
}

// ==========================================
// PHASE 4: EXAMINATION, RESULTS & TIMETABLE
// ==========================================

model grading_scales {
  id            String          @id @default(cuid())
  schoolId      String
  name          String
  description   String?
  isDefault     Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  schools       schools         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grading_rules grading_rules[]
  exams         exams[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model grading_rules {
  id             String         @id @default(cuid())
  gradingScaleId String
  grade          String
  minPercentage  Decimal        @db.Decimal(5, 2)
  maxPercentage  Decimal        @db.Decimal(5, 2)
  gradePoint     Decimal        @default(0) @db.Decimal(4, 2)
  description    String?
  order          Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  grading_scales grading_scales @relation(fields: [gradingScaleId], references: [id], onDelete: Cascade)

  @@index([gradingScaleId])
}

model exams {
  id              String           @id @default(cuid())
  schoolId        String
  academicYearId  String
  gradingScaleId  String?
  name            String
  examType        ExamType         @default(MID_TERM)
  term            String
  startDate       DateTime
  endDate         DateTime
  status          ExamStatus       @default(UPCOMING)
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  schools         schools          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academic_years  academic_years   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  grading_scales  grading_scales?  @relation(fields: [gradingScaleId], references: [id], onDelete: SetNull)
  exam_schedules  exam_schedules[]
  exam_results    exam_results[]

  @@index([schoolId, academicYearId])
}

model exam_schedules {
  id                   String       @id @default(cuid())
  schoolId             String
  examId               String
  classId              String
  sectionId            String?
  subjectId            String
  examDate             DateTime
  startTime            String
  endTime              String
  roomNumber           String?
  invigilatorTeacherId String?
  maxMarks             Decimal      @default(100.00) @db.Decimal(6, 2)
  passingMarks         Decimal      @default(40.00) @db.Decimal(6, 2)
  theoryMarksMax       Decimal?     @db.Decimal(6, 2)
  practicalMarksMax    Decimal?     @db.Decimal(6, 2)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  schools              schools      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  exams                exams        @relation(fields: [examId], references: [id], onDelete: Cascade)
  classes              classes      @relation(fields: [classId], references: [id], onDelete: Cascade)
  sections             sections?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  subjects             subjects     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  invigilatorTeacher   teachers?    @relation("TeacherExamInvigilation", fields: [invigilatorTeacherId], references: [id], onDelete: SetNull)
  exam_marks           exam_marks[]

  @@unique([examId, classId, subjectId])
  @@index([schoolId, examId, classId])
  @@index([schoolId, examDate])
}

model exam_marks {
  id             String         @id @default(cuid())
  schoolId       String
  examScheduleId String
  studentId      String
  theoryMarks    Decimal?       @db.Decimal(6, 2)
  practicalMarks Decimal?       @db.Decimal(6, 2)
  internalMarks  Decimal?       @db.Decimal(6, 2)
  marksObtained  Decimal        @db.Decimal(6, 2)
  percentage     Decimal        @db.Decimal(5, 2)
  grade          String?
  isAbsent       Boolean        @default(false)
  remarks        String?
  gradedById     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  schools        schools        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  exam_schedules exam_schedules @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)
  students       students       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradedBy       users?         @relation("UserExamMarks", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([examScheduleId, studentId])
  @@index([schoolId, studentId])
}

model exam_results {
  id                 String           @id @default(cuid())
  schoolId           String
  examId             String
  studentId          String
  classId            String
  sectionId          String?
  totalMaxMarks      Decimal          @db.Decimal(8, 2)
  totalObtainedMarks Decimal          @db.Decimal(8, 2)
  percentage         Decimal          @db.Decimal(5, 2)
  gpa                Decimal?         @db.Decimal(4, 2)
  overallGrade       String?
  rank               Int?
  status             ExamResultStatus @default(PENDING)
  teacherRemarks     String?
  principalRemarks   String?
  isApproved         Boolean          @default(false)
  isPublished        Boolean          @default(false)
  approvedById       String?
  publishedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  schools            schools          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  exams              exams            @relation(fields: [examId], references: [id], onDelete: Cascade)
  students           students         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classes            classes          @relation(fields: [classId], references: [id], onDelete: Cascade)
  sections           sections?        @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  approvedBy         users?           @relation("UserExamResultsApproved", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([examId, studentId])
  @@index([schoolId, examId, classId])
}

model class_timetables {
  id             String         @id @default(cuid())
  schoolId       String
  academicYearId String
  classId        String
  sectionId      String
  subjectId      String?
  teacherId      String?
  dayOfWeek      DayOfWeek
  periodNumber   Int
  periodName     String         @default("Period")
  isBreak        Boolean        @default(false)
  startTime      String
  endTime        String
  roomNumber     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  schools        schools        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academic_years academic_years @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classes        classes        @relation(fields: [classId], references: [id], onDelete: Cascade)
  sections       sections       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjects       subjects?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teachers       teachers?      @relation("TeacherTimetable", fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([schoolId, academicYearId, classId, sectionId, dayOfWeek, periodNumber])
  @@index([schoolId, classId, sectionId])
  @@index([schoolId, teacherId, dayOfWeek])
}

model homework {
  id                   String                 @id @default(cuid())
  schoolId             String
  classId              String
  sectionId            String?
  subjectId            String
  teacherId            String
  title                String
  description          String
  dueDate              DateTime
  attachmentUrl        String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  schools              schools                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes              classes                @relation(fields: [classId], references: [id], onDelete: Cascade)
  sections             sections?              @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  subjects             subjects               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teachers             teachers               @relation("TeacherHomework", fields: [teacherId], references: [id], onDelete: Cascade)
  homework_submissions homework_submissions[]

  @@index([schoolId, classId])
  @@index([schoolId, teacherId])
  @@index([schoolId, dueDate])
}

model homework_submissions {
  id             String         @id @default(cuid())
  schoolId       String
  homeworkId     String
  studentId      String
  submissionText String?
  attachmentUrl  String?
  status         HomeworkStatus @default(PENDING)
  marks          Decimal?       @db.Decimal(5, 2)
  feedback       String?
  submittedAt    DateTime?
  evaluatedAt    DateTime?
  evaluatedById  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  schools        schools        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  homework       homework       @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  students       students       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  evaluatedBy    users?         @relation("UserHomeworkEvaluated", fields: [evaluatedById], references: [id], onDelete: SetNull)

  @@unique([homeworkId, studentId])
  @@index([schoolId, studentId])
  @@index([schoolId, homeworkId])
}

enum ExamType {
  ANNUAL
  HALF_YEARLY
  QUARTERLY
  UNIT_TEST
  MID_TERM
  FINAL
  ASSESSMENT
}

enum ExamStatus {
  UPCOMING
  ONGOING
  COMPLETED
  PUBLISHED
  CANCELLED
}

enum ExamResultStatus {
  PASS
  FAIL
  WITHHELD
  PENDING
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum HomeworkStatus {
  PENDING
  SUBMITTED
  EVALUATED
  LATE
}

// ==========================================
// PHASE 5.1: TRANSPORT MANAGEMENT MODELS
// ==========================================

model vehicles {
  id                 String                @id @default(cuid())
  schoolId           String
  registrationNumber String
  name               String
  type               VehicleType           @default(BUS)
  capacity           Int
  manufacturer       String?
  model              String?
  registrationDate   DateTime?
  insuranceExpiry    DateTime?
  fitnessExpiry      DateTime?
  permitExpiry       DateTime?
  pollutionExpiry    DateTime?
  status             VehicleStatus         @default(ACTIVE)
  photoUrl           String?
  documentId         String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  schools            schools               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments        vehicle_assignments[]

  @@unique([schoolId, registrationNumber])
  @@index([schoolId])
  @@index([schoolId, status])
}

model transport_routes {
  id                     String                          @id @default(cuid())
  schoolId               String
  name                   String
  code                   String
  startPoint             String
  destination            String
  description            String?
  journeyDurationMinutes Int?
  status                 RouteStatus                     @default(ACTIVE)
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt

  schools                schools                         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  stops                  transport_stops[]
  assignments            vehicle_assignments[]
  allocations            student_transport_allocations[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([schoolId, status])
}

model transport_stops {
  id                String                          @id @default(cuid())
  schoolId          String
  routeId           String
  name              String
  address           String?
  sequence          Int
  pickupTime        String?
  dropTime          String?
  fare              Decimal                         @default(0.00) @db.Decimal(10, 2)
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt

  schools           schools                         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  route             transport_routes                @relation(fields: [routeId], references: [id], onDelete: Cascade)
  pickupAllocations student_transport_allocations[] @relation("PickupStop")
  dropAllocations   student_transport_allocations[] @relation("DropStop")

  @@unique([routeId, sequence])
  @@index([schoolId])
  @@index([routeId])
}

model drivers {
  id               String                @id @default(cuid())
  schoolId         String
  employeeId       String
  firstName        String
  lastName         String
  phone            String
  email            String?
  address          String?
  emergencyContact String?
  licenseNumber    String
  licenseExpiry    DateTime
  status           DriverStatus          @default(ACTIVE)
  photo            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  schools          schools               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments      vehicle_assignments[]

  @@unique([schoolId, licenseNumber])
  @@unique([schoolId, employeeId])
  @@index([schoolId])
  @@index([schoolId, status])
}

model vehicle_assignments {
  id             String           @id @default(cuid())
  schoolId       String
  vehicleId      String
  routeId        String
  driverId       String
  attendantName  String?
  attendantPhone String?
  effectiveDate  DateTime         @default(now())
  endDate        DateTime?
  status         AssignmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  schools        schools          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  vehicle        vehicles         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  route          transport_routes @relation(fields: [routeId], references: [id], onDelete: Cascade)
  driver         drivers          @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([vehicleId, status])
  @@index([driverId, status])
  @@index([routeId, status])
}

model student_transport_allocations {
  id             String                @id @default(cuid())
  schoolId       String
  studentId      String
  academicYearId String
  routeId        String
  pickupStopId   String
  dropStopId     String
  effectiveDate  DateTime              @default(now())
  endDate        DateTime?
  fare           Decimal               @db.Decimal(10, 2)
  status         AllocationStatus      @default(ACTIVE)
  invoiceId      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  schools        schools               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student        students              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear   academic_years        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  route          transport_routes      @relation(fields: [routeId], references: [id], onDelete: Cascade)
  pickupStop     transport_stops       @relation("PickupStop", fields: [pickupStopId], references: [id], onDelete: Cascade)
  dropStop       transport_stops       @relation("DropStop", fields: [dropStopId], references: [id], onDelete: Cascade)
  invoice        student_fee_invoices? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([studentId, status])
  @@index([routeId, status])
  @@index([academicYearId])
}

enum VehicleType {
  BUS
  MINI_BUS
  VAN
  OTHER
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum RouteStatus {
  ACTIVE
  INACTIVE
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AllocationStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// ==========================================
// PHASE 5.2: LIBRARY MANAGEMENT MODELS
// ==========================================

model library_settings {
  id                   String   @id @default(cuid())
  schoolId             String   @unique
  defaultBorrowingDays Int      @default(14)
  maxBooksStudent      Int      @default(3)
  maxBooksFaculty      Int      @default(5)
  maxBooksStaff        Int      @default(3)
  finePerDay           Decimal  @default(2.00) @db.Decimal(10, 2)
  gracePeriodDays      Int      @default(1)
  maxFineCap           Decimal  @default(500.00) @db.Decimal(10, 2)
  lostBookMultiplier   Decimal  @default(1.50) @db.Decimal(5, 2)
  damageFineFixed      Decimal  @default(100.00) @db.Decimal(10, 2)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  schools              schools  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model library_categories {
  id          String          @id @default(cuid())
  schoolId    String
  name        String
  code        String?
  description String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  schools     schools         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  books       library_books[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model library_authors {
  id          String          @id @default(cuid())
  schoolId    String
  name        String
  biography   String?
  contactInfo String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  schools     schools         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  books       library_books[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model library_publishers {
  id        String          @id @default(cuid())
  schoolId  String
  name      String
  address   String?
  phone     String?
  email     String?
  website   String?
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  schools   schools         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  books     library_books[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model library_books {
  id              String                 @id @default(cuid())
  schoolId        String
  title           String
  isbn            String?
  categoryId      String
  authorId        String?
  publisherId     String?
  authorName      String?
  publisherName   String?
  edition         String?
  language        String                 @default("English")
  publicationYear Int?
  description     String?
  shelfNumber     String?
  rackNumber      String?
  coverImageUrl   String?
  totalCopies     Int                    @default(0)
  availableCopies Int                    @default(0)
  isActive        Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  schools         schools                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  category        library_categories     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author          library_authors?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  publisher       library_publishers?    @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  copies          library_book_copies[]
  reservations    library_reservations[]

  @@index([schoolId, title])
  @@index([schoolId, isbn])
  @@index([schoolId, categoryId])
}

model library_book_copies {
  id              String                 @id @default(cuid())
  schoolId        String
  bookId          String
  accessionNumber String
  barcode         String?
  purchaseDate    DateTime?
  purchasePrice   Decimal?               @db.Decimal(10, 2)
  shelfNumber     String?
  rackNumber      String?
  condition       BookCondition          @default(GOOD)
  status          BookCopyStatus         @default(AVAILABLE)
  remarks         String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  schools         schools                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  book            library_books          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  issues          library_issues[]
  reservations    library_reservations[]

  @@unique([schoolId, accessionNumber])
  @@index([schoolId, status])
  @@index([bookId, status])
}

model library_members {
  id              String                 @id @default(cuid())
  schoolId        String
  memberNumber    String
  memberType      LibraryMemberType
  studentId       String?
  teacherId       String?
  userId          String?
  startDate       DateTime               @default(now())
  expiryDate      DateTime
  maxBooksAllowed Int                    @default(3)
  status          LibraryMemberStatus    @default(ACTIVE)
  notes           String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  schools         schools                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student         students?              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher         teachers?              @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  user            users?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  issues          library_issues[]
  reservations    library_reservations[]
  fines           library_fines[]

  @@unique([schoolId, memberNumber])
  @@index([schoolId, memberType])
  @@index([schoolId, studentId])
  @@index([schoolId, teacherId])
}

model library_issues {
  id                String              @id @default(cuid())
  schoolId          String
  copyId            String
  memberId          String
  issueDate         DateTime            @default(now())
  dueDate           DateTime
  returnDate        DateTime?
  issuedById        String?
  receivedById      String?
  status            BookIssueStatus     @default(ISSUED)
  conditionOnIssue  BookCondition       @default(GOOD)
  conditionOnReturn BookCondition?
  issueRemarks      String?
  returnRemarks     String?
  overdueDays       Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  schools           schools             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  copy              library_book_copies @relation(fields: [copyId], references: [id], onDelete: Cascade)
  member            library_members     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  issuedBy          users?              @relation("IssuedByUser", fields: [issuedById], references: [id], onDelete: SetNull)
  receivedBy        users?              @relation("ReceivedByUser", fields: [receivedById], references: [id], onDelete: SetNull)
  fines             library_fines[]

  @@index([schoolId, status])
  @@index([copyId, status])
  @@index([memberId, status])
  @@index([dueDate])
}

model library_fines {
  id            String                    @id @default(cuid())
  schoolId      String
  issueId       String?
  memberId      String
  fineType      LibraryFineType           @default(OVERDUE)
  amount        Decimal                   @db.Decimal(10, 2)
  paidAmount    Decimal                   @default(0.00) @db.Decimal(10, 2)
  balance       Decimal                   @db.Decimal(10, 2)
  status        LibraryFineStatus         @default(UNPAID)
  overdueDays   Int                       @default(0)
  waivedAmount  Decimal                   @default(0.00) @db.Decimal(10, 2)
  waivedReason  String?
  waivedById    String?
  paidAt        DateTime?
  paymentMethod String?
  transactionRef String?
  feeInvoiceId  String?
  remarks       String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  schools       schools                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  issue         library_issues?           @relation(fields: [issueId], references: [id], onDelete: SetNull)
  member        library_members           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  waivedBy      users?                    @relation("FineWaivedByUser", fields: [waivedById], references: [id], onDelete: SetNull)
  feeInvoice    student_fee_invoices?     @relation(fields: [feeInvoiceId], references: [id], onDelete: SetNull)
  adjustments   library_fine_adjustments[]

  @@index([schoolId, status])
  @@index([memberId, status])
  @@index([issueId])
}

model library_fine_adjustments {
  id        String        @id @default(cuid())
  fineId    String
  action    String        // PAYMENT, WAIVER, ADJUSTMENT
  amount    Decimal       @db.Decimal(10, 2)
  reason    String?
  userId    String?
  createdAt DateTime      @default(now())

  fine      library_fines @relation(fields: [fineId], references: [id], onDelete: Cascade)
  user      users?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([fineId])
}

model library_reservations {
  id              String                    @id @default(cuid())
  schoolId        String
  bookId          String
  memberId        String
  copyId          String?
  reservationDate DateTime                  @default(now())
  expiryDate      DateTime?
  status          LibraryReservationStatus  @default(PENDING)
  notifiedAt      DateTime?
  fulfilledAt     DateTime?
  notes           String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  schools         schools                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  book            library_books             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  member          library_members           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  copy            library_book_copies?      @relation(fields: [copyId], references: [id], onDelete: SetNull)

  @@index([schoolId, status])
  @@index([bookId, status])
  @@index([memberId, status])
}

enum BookCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum BookCopyStatus {
  AVAILABLE
  ISSUED
  RESERVED
  LOST
  DAMAGED
  UNDER_MAINTENANCE
}

enum LibraryMemberType {
  STUDENT
  FACULTY
  STAFF
}

enum LibraryMemberStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum BookIssueStatus {
  ISSUED
  RETURNED
  OVERDUE
  LOST
  DAMAGED
}

enum LibraryFineType {
  OVERDUE
  LOST_BOOK
  DAMAGE
  MANUAL
}

enum LibraryFineStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  WAIVED
}

enum LibraryReservationStatus {
  PENDING
  READY
  FULFILLED
  CANCELLED
  EXPIRED
}

// ==========================================
// INVENTORY & ASSET MANAGEMENT (PHASE 5.3)
// ==========================================

model inventory_categories {
  id          String            @id @default(cuid())
  schoolId    String
  name        String
  code        String
  description String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  schools     schools           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  items       inventory_items[]

  @@unique([schoolId, code])
  @@unique([schoolId, name])
  @@index([schoolId])
}

model inventory_locations {
  id            String                     @id @default(cuid())
  schoolId      String
  name          String
  code          String
  building      String?
  floor         String?
  roomNumber    String?
  description   String?
  isActive      Boolean                    @default(true)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  schools       schools                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  items         inventory_items[]
  assets        inventory_assets[]
  transfersFrom inventory_stock_transfers[] @relation("FromLocation")
  transfersTo   inventory_stock_transfers[] @relation("ToLocation")

  @@unique([schoolId, code])
  @@index([schoolId])
}

model inventory_suppliers {
  id                 String                        @id @default(cuid())
  schoolId           String
  name               String
  code               String?
  contactPerson      String?
  email              String?
  phone              String?
  address            String?
  gstin              String?
  notes              String?
  isActive           Boolean                       @default(true)
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  schools            schools                       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  items              inventory_items[]
  assets             inventory_assets[]
  purchaseOrders     inventory_purchase_orders[]
  maintenanceTickets inventory_maintenance_tickets[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model inventory_items {
  id                 String                         @id @default(cuid())
  schoolId           String
  categoryId         String
  primaryLocationId  String?
  primarySupplierId  String?
  name               String
  sku                String
  description        String?
  brand              String?
  modelNumber        String?
  unitOfMeasurement  String                         @default("PCS")
  itemType           InventoryItemType              @default(CONSUMABLE)
  purchasePrice      Decimal                        @default(0) @db.Decimal(12, 2)
  currentStock       Int                            @default(0)
  minStockThreshold  Int                            @default(5)
  purchaseDate       DateTime?
  warrantyExpiry     DateTime?
  isActive           Boolean                        @default(true)
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  schools            schools                        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  category           inventory_categories           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  primaryLocation    inventory_locations?           @relation(fields: [primaryLocationId], references: [id], onDelete: SetNull)
  primarySupplier    inventory_suppliers?           @relation(fields: [primarySupplierId], references: [id], onDelete: SetNull)
  movements          inventory_stock_movements[]
  assets             inventory_assets[]
  purchaseOrderItems inventory_purchase_order_items[]
  stockTransfers     inventory_stock_transfers[]

  @@unique([schoolId, sku])
  @@index([schoolId, categoryId])
  @@index([schoolId, itemType])
  @@index([schoolId, currentStock])
}

model inventory_stock_movements {
  id               String            @id @default(cuid())
  schoolId         String
  itemId           String
  movementType     StockMovementType
  quantity         Int
  previousQuantity Int
  newQuantity      Int
  unitPrice        Decimal?          @db.Decimal(12, 2)
  referenceNumber  String?
  batchNumber      String?
  reason           String?
  sourceLocationId String?
  targetLocationId String?
  performedById    String?
  createdAt        DateTime          @default(now())
  schools          schools           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  item             inventory_items   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  performedBy      users?            @relation(fields: [performedById], references: [id], onDelete: SetNull)

  @@index([schoolId, itemId])
  @@index([schoolId, movementType])
  @@index([schoolId, createdAt])
}

model inventory_stock_transfers {
  id               String              @id @default(cuid())
  schoolId         String
  transferNumber   String
  itemId           String
  sourceLocationId String
  targetLocationId String
  quantity         Int
  status           TransferStatus      @default(COMPLETED)
  transferDate     DateTime            @default(now())
  notes            String?
  requestedById    String?
  approvedById     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  schools          schools             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  item             inventory_items     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  sourceLocation   inventory_locations @relation("FromLocation", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  targetLocation   inventory_locations @relation("ToLocation", fields: [targetLocationId], references: [id], onDelete: Restrict)

  @@unique([schoolId, transferNumber])
  @@index([schoolId])
}

model inventory_assets {
  id                      String                        @id @default(cuid())
  schoolId                String
  assetNumber             String
  itemId                  String?
  supplierId              String?
  locationId              String?
  name                    String
  serialNumber            String?
  brand                   String?
  modelNumber             String?
  department              String?
  purchaseDate            DateTime
  purchasePrice           Decimal                       @db.Decimal(12, 2)
  warrantyExpiry          DateTime?
  warrantyDetails         String?
  condition               AssetCondition                @default(NEW)
  status                  AssetStatus                   @default(AVAILABLE)
  usefulLifeMonths        Int                           @default(36)
  salvageValue            Decimal                       @default(0) @db.Decimal(12, 2)
  depreciationMethod      DepreciationMethod            @default(STRAIGHT_LINE)
  currentBookValue        Decimal                       @db.Decimal(12, 2)
  accumulatedDepreciation Decimal                       @default(0) @db.Decimal(12, 2)
  lastDepreciationDate    DateTime?
  notes                   String?
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  schools                 schools                       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  item                    inventory_items?              @relation(fields: [itemId], references: [id], onDelete: SetNull)
  supplier                inventory_suppliers?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  location                inventory_locations?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assignments             inventory_asset_assignments[]
  depreciations           inventory_depreciations[]
  maintenanceTickets      inventory_maintenance_tickets[]

  @@unique([schoolId, assetNumber])
  @@index([schoolId, status])
  @@index([schoolId, condition])
  @@index([schoolId, locationId])
}

model inventory_asset_assignments {
  id                 String             @id @default(cuid())
  schoolId           String
  assetId            String
  teacherId          String?
  userId             String?
  department         String?
  locationId         String?
  assignedDate       DateTime           @default(now())
  returnDate         DateTime?
  expectedReturnDate DateTime?
  assignedCondition  AssetCondition     @default(GOOD)
  returnCondition    AssetCondition?
  isReturned         Boolean            @default(false)
  assignmentRemarks  String?
  returnRemarks      String?
  assignedById       String?
  receivedById       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  schools            schools            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  asset              inventory_assets   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  teacher            teachers?          @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  user               users?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId, assetId])
  @@index([schoolId, isReturned])
}

model inventory_depreciations {
  id                  String             @id @default(cuid())
  schoolId            String
  assetId             String
  fiscalYear          String
  periodStartDate     DateTime
  periodEndDate       DateTime
  depreciationMethod  DepreciationMethod
  openingBookValue    Decimal            @db.Decimal(12, 2)
  depreciationAmount  Decimal            @db.Decimal(12, 2)
  closingBookValue    Decimal            @db.Decimal(12, 2)
  ratePercentage      Decimal?           @db.Decimal(5, 2)
  calculationRemarks  String?
  calculatedById      String?
  createdAt           DateTime           @default(now())
  schools             schools            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  asset               inventory_assets   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([schoolId, assetId])
  @@index([schoolId, fiscalYear])
}

model inventory_maintenance_tickets {
  id               String                     @id @default(cuid())
  schoolId         String
  ticketNumber     String
  assetId          String
  supplierId       String?
  reportedById     String?
  assignedStaffId  String?
  title            String
  issueDescription String
  priority         MaintenancePriority        @default(MEDIUM)
  status           MaintenanceStatus          @default(OPEN)
  estimatedCost    Decimal                    @default(0) @db.Decimal(12, 2)
  actualCost       Decimal                    @default(0) @db.Decimal(12, 2)
  openedAt         DateTime                   @default(now())
  resolvedAt       DateTime?
  closedAt         DateTime?
  workNotes        String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  schools          schools                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  asset            inventory_assets           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  supplier         inventory_suppliers?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  logs             inventory_maintenance_logs[]

  @@unique([schoolId, ticketNumber])
  @@index([schoolId, status])
  @@index([schoolId, priority])
}

model inventory_maintenance_logs {
  id             String                        @id @default(cuid())
  ticketId       String
  previousStatus MaintenanceStatus?
  newStatus      MaintenanceStatus
  note           String
  actionCost     Decimal?                      @db.Decimal(12, 2)
  performedById  String?
  createdAt      DateTime                      @default(now())
  ticket         inventory_maintenance_tickets @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model inventory_purchase_orders {
  id                   String                          @id @default(cuid())
  schoolId             String
  poNumber             String
  supplierId           String
  orderDate            DateTime                        @default(now())
  expectedDeliveryDate DateTime?
  deliveryDate         DateTime?
  subtotal             Decimal                         @default(0) @db.Decimal(12, 2)
  taxAmount            Decimal                         @default(0) @db.Decimal(12, 2)
  totalAmount          Decimal                         @default(0) @db.Decimal(12, 2)
  status               PurchaseOrderStatus             @default(DRAFT)
  notes                String?
  createdById          String?
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt
  schools              schools                         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  supplier             inventory_suppliers             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items                inventory_purchase_order_items[]

  @@unique([schoolId, poNumber])
  @@index([schoolId, status])
}

model inventory_purchase_order_items {
  id               String                    @id @default(cuid())
  purchaseOrderId  String
  itemId           String
  orderedQuantity  Int
  receivedQuantity Int                       @default(0)
  unitPrice        Decimal                   @db.Decimal(12, 2)
  taxRate          Decimal                   @default(0) @db.Decimal(5, 2)
  totalPrice       Decimal                   @db.Decimal(12, 2)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  purchaseOrder    inventory_purchase_orders @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item             inventory_items           @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([itemId])
}

enum InventoryItemType {
  CONSUMABLE
  ASSET
}

enum StockMovementType {
  INWARD
  OUTWARD
  ADJUSTMENT
  TRANSFER
  DAMAGED
  EXPIRED
  RETURN
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  UNDER_MAINTENANCE
  DAMAGED
  DISPOSED
  LOST
}

enum DepreciationMethod {
  STRAIGHT_LINE
  WRITTEN_DOWN_VALUE
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum TransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

// ==========================================
// PHASE 6 MODELS: PARENT & STUDENT PORTAL
// ==========================================

model portal_settings {
  id                         String   @id @default(cuid())
  schoolId                   String   @unique
  isParentPortalEnabled      Boolean  @default(true)
  isStudentPortalEnabled     Boolean  @default(true)
  allowParentFeePayment      Boolean  @default(false)
  allowStudentHomeworkUpload Boolean  @default(false)
  showExamRank               Boolean  @default(false)
  showFeeToStudent           Boolean  @default(false)
  allowAttendanceDownload    Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  schools                    schools  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model portal_invitations {
  id          String           @id @default(cuid())
  schoolId    String
  email       String
  role        Role             // PARENT or STUDENT
  parentId    String?
  studentId   String?
  token       String           @unique
  expiresAt   DateTime
  status      InvitationStatus @default(PENDING)
  invitedById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  schools     schools          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parents     parents?         @relation(fields: [parentId], references: [id], onDelete: Cascade)
  students    students?        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([token])
  @@index([email])
}

model announcements {
  id             String               @id @default(cuid())
  schoolId       String
  title          String
  content        String
  category       AnnouncementCategory @default(GENERAL)
  targetAudience TargetAudience       @default(ALL)
  isPublished    Boolean              @default(true)
  publishedAt    DateTime             @default(now())
  expiresAt      DateTime?
  attachmentUrl  String?
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  schools        schools              @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([targetAudience])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AnnouncementCategory {
  GENERAL
  ACADEMIC
  EXAMINATION
  HOLIDAY
  SPORTS
  EVENT
}

enum TargetAudience {
  ALL
  PARENTS
  STUDENTS
  TEACHERS
  STAFF
}

// ==========================================
// PHASE 7 MODELS: NOTIFICATION SYSTEM
// ==========================================

model notifications {
  id             String                 @id @default(cuid())
  schoolId       String
  eventType      NotificationEventType
  title          String
  content        String
  priority       NotificationPriority   @default(NORMAL)
  channels       NotificationChannel[]
  targetAudience TargetAudience?
  data           Json?
  createdById    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  schools        schools                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  recipients     notification_recipients[]
  deliveries     notification_deliveries[]

  @@index([schoolId])
  @@index([eventType])
  @@index([createdAt])
}

model notification_recipients {
  id             String        @id @default(cuid())
  notificationId String
  userId         String
  schoolId       String
  isRead         Boolean       @default(false)
  readAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  notifications  notifications @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  users          users         @relation(fields: [userId], references: [id], onDelete: Cascade)
  schools        schools       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, isRead])
  @@index([schoolId])
}

model notification_templates {
  id          String                @id @default(cuid())
  schoolId    String
  name        String
  eventType   NotificationEventType
  channel     NotificationChannel
  subject     String?
  body        String
  variables   Json?
  isActive    Boolean               @default(true)
  isSystem    Boolean               @default(false)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  schools     schools               @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, eventType, channel])
  @@index([schoolId])
  @@index([eventType])
}

model notification_preferences {
  id          String                @id @default(cuid())
  userId      String
  schoolId    String
  eventType   NotificationEventType
  inApp       Boolean               @default(true)
  email       Boolean               @default(true)
  sms         Boolean               @default(false)
  push        Boolean               @default(false)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  users       users                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  schools     schools               @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType])
  @@index([userId])
  @@index([schoolId])
}

model notification_deliveries {
  id               String               @id @default(cuid())
  notificationId   String
  recipientId      String?
  userId           String
  schoolId         String
  channel          NotificationChannel
  recipientTarget  String               // Email address, phone number, push token, or userId
  status           DeliveryStatus       @default(PENDING)
  attemptCount     Int                  @default(0)
  maxAttempts      Int                  @default(3)
  lastAttemptAt    DateTime?
  deliveredAt      DateTime?
  errorMessage     String?
  providerResponse Json?
  idempotencyKey   String?              @unique
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  notifications    notifications        @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  users            users                @relation(fields: [userId], references: [id], onDelete: Cascade)
  schools          schools              @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([status])
  @@index([userId])
  @@index([notificationId])
}

model notification_settings {
  id                    String   @id @default(cuid())
  schoolId              String   @unique
  emailEnabled          Boolean  @default(true)
  smsEnabled            Boolean  @default(false)
  pushEnabled           Boolean  @default(false)
  inAppEnabled          Boolean  @default(true)
  senderEmail           String?
  senderName            String?
  smsSenderId           String?
  quietHoursStart       String?  // e.g. "22:00"
  quietHoursEnd         String?  // e.g. "07:00"
  maxDailySmsPerStudent Int      @default(5)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  schools               schools  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

enum NotificationEventType {
  ATTENDANCE_MARKED
  STUDENT_ABSENT
  FEE_INVOICE_GENERATED
  FEE_PAYMENT_RECEIVED
  FEE_DUE_REMINDER
  EXAM_TIMETABLE_PUBLISHED
  EXAM_RESULTS_PUBLISHED
  HOMEWORK_ASSIGNED
  HOMEWORK_DEADLINE_REMINDER
  ANNOUNCEMENT_PUBLISHED
  TRANSPORT_UPDATE
  LIBRARY_BOOK_ISSUED
  LIBRARY_BOOK_DUE
  GENERAL_NOTICE
  LEAVE_APPLICATION_SUBMITTED
  LEAVE_STATUS_UPDATED
  PAYROLL_GENERATED
  PAYSLIP_PUBLISHED
  PAYROLL_PAID
  EXPENSE_SUBMITTED
  EXPENSE_STATUS_UPDATED
  SAAS_TRIAL_STARTED
  SAAS_TRIAL_EXPIRING_SOON
  SAAS_TRIAL_EXPIRED
  SAAS_SUBSCRIPTION_ACTIVATED
  SAAS_SUBSCRIPTION_UPGRADED
  SAAS_SUBSCRIPTION_SUSPENDED
  SAAS_INVOICE_GENERATED
  SAAS_PAYMENT_SUCCESS
  SAAS_PAYMENT_FAILED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  RETRYING
}

// ==========================================
// PHASE 8: HR, PAYROLL & EXPENSES MANAGEMENT
// ==========================================

enum EmploymentType {
  PERMANENT
  TEMPORARY
  CONTRACTUAL
  PART_TIME
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
  TERMINATED
  RETIRED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ComponentType {
  EARNING
  DEDUCTION
}

enum CalculationType {
  FLAT
  PERCENTAGE
}

enum PayrollPeriodStatus {
  DRAFT
  PROCESSING
  APPROVED
  FINALIZED
  PAID
}

enum PayrollStatus {
  DRAFT
  APPROVED
  FINALIZED
  PAID
  CANCELLED
}

enum ExpenseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

model departments {
  id            String              @id @default(cuid())
  schoolId      String
  name          String
  code          String?
  description   String?
  headTeacherId String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  schools       schools             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  headTeacher   teachers?           @relation("DepartmentHead", fields: [headTeacherId], references: [id], onDelete: SetNull)
  employee_profiles employee_profiles[]
  expenses      expenses[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model designations {
  id            String              @id @default(cuid())
  schoolId      String
  title         String
  code          String?
  description   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  schools       schools             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employee_profiles employee_profiles[]

  @@unique([schoolId, title])
  @@index([schoolId])
}

model employee_profiles {
  id                       String               @id @default(cuid())
  schoolId                 String
  teacherId                String               @unique
  departmentId             String?
  designationId            String?
  employmentType           EmploymentType       @default(PERMANENT)
  employmentStatus         EmploymentStatus     @default(ACTIVE)
  joiningDate              DateTime             @default(now())
  confirmationDate         DateTime?
  contractEndDate          DateTime?
  reportingManagerId       String?
  workEmail                String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  bloodGroup               String?
  address                  String?
  bankName                 String?
  accountNumber            String?
  bankIfsc                 String?
  panNumber                String?
  uanNumber                String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  schools                  schools              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teachers                 teachers             @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  departments              departments?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designations             designations?        @relation(fields: [designationId], references: [id], onDelete: SetNull)
  reportingManager         employee_profiles?   @relation("EmployeeManager", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  subordinates             employee_profiles[]  @relation("EmployeeManager")
  employee_documents       employee_documents[]
  leave_balances           leave_balances[]
  leave_applications       leave_applications[]
  employee_salary_assignments employee_salary_assignments[]
  payroll_records          payroll_records[]
  payslips                 payslips[]
  expenses                 expenses[]

  @@index([schoolId])
  @@index([departmentId])
  @@index([designationId])
}

model employee_documents {
  id                String             @id @default(cuid())
  schoolId          String
  employeeProfileId String
  documentType      String             // e.g. "ID_PROOF", "RESUME", "CONTRACT", "CERTIFICATE"
  title             String
  fileUrl           String
  fileSize          Int?
  mimeType          String?
  verified          Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  schools           schools            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employee_profiles employee_profiles  @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([employeeProfileId])
}

model leave_types {
  id           String               @id @default(cuid())
  schoolId     String
  name         String
  code         String
  daysAllowed  Int                  @default(12)
  isPaid       Boolean              @default(true)
  carryForward Boolean              @default(false)
  description  String?
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  schools      schools              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  leave_balances leave_balances[]
  leave_applications leave_applications[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model leave_balances {
  id                String             @id @default(cuid())
  schoolId          String
  employeeProfileId String
  leaveTypeId       String
  year              Int
  allocated         Float              @default(0)
  used              Float              @default(0)
  pending           Float              @default(0)
  remaining         Float              @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  schools           schools            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employee_profiles employee_profiles  @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  leave_types       leave_types        @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeProfileId, leaveTypeId, year])
  @@index([schoolId])
}

model leave_applications {
  id                 String             @id @default(cuid())
  schoolId           String
  employeeProfileId  String
  leaveTypeId        String
  startDate          DateTime
  endDate            DateTime
  totalDays          Float
  reason             String
  status             LeaveStatus        @default(PENDING)
  appliedAt          DateTime           @default(now())
  approvedById       String?
  approvedAt         DateTime?
  rejectionReason    String?
  cancellationReason String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  schools            schools            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employee_profiles  employee_profiles  @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  leave_types        leave_types        @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  approvedBy         users?             @relation("LeaveApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([employeeProfileId])
  @@index([status])
}

model salary_structures {
  id                          String                        @id @default(cuid())
  schoolId                    String
  name                        String
  code                        String?
  description                 String?
  baseSalary                  Decimal                       @default(0) @db.Decimal(12, 2)
  isActive                    Boolean                       @default(true)
  effectiveDate               DateTime                      @default(now())
  endDate                     DateTime?
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt

  schools                     schools                       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  salary_components           salary_components[]
  employee_salary_assignments employee_salary_assignments[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model salary_components {
  id                 String            @id @default(cuid())
  salaryStructureId  String
  name               String
  type               ComponentType
  calculationType    CalculationType
  percentage         Decimal?          @db.Decimal(5, 2)
  flatAmount         Decimal?          @db.Decimal(12, 2)
  isTaxable          Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  salary_structures  salary_structures @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)

  @@index([salaryStructureId])
}

model employee_salary_assignments {
  id                String             @id @default(cuid())
  schoolId          String
  employeeProfileId String
  salaryStructureId String
  customBaseSalary  Decimal?           @db.Decimal(12, 2)
  effectiveFrom     DateTime           @default(now())
  effectiveTo       DateTime?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  schools           schools            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employee_profiles employee_profiles  @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  salary_structures salary_structures  @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([employeeProfileId])
}

model payroll_periods {
  id               String              @id @default(cuid())
  schoolId         String
  month            Int
  year             Int
  startDate        DateTime
  endDate          DateTime
  totalWorkingDays Int                 @default(30)
  status           PayrollPeriodStatus @default(DRAFT)
  finalizedAt      DateTime?
  finalizedById    String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  schools          schools             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  finalizedBy      users?              @relation("PayrollPeriodFinalizer", fields: [finalizedById], references: [id], onDelete: SetNull)
  payroll_records  payroll_records[]

  @@unique([schoolId, month, year])
  @@index([schoolId])
}

model payroll_records {
  id                  String                @id @default(cuid())
  schoolId            String
  payrollPeriodId     String
  employeeProfileId   String
  baseSalary          Decimal               @default(0) @db.Decimal(12, 2)
  grossEarnings       Decimal               @default(0) @db.Decimal(12, 2)
  totalDeductions     Decimal               @default(0) @db.Decimal(12, 2)
  netSalary           Decimal               @default(0) @db.Decimal(12, 2)
  workingDays         Int                   @default(30)
  presentDays         Float                 @default(30)
  absentDays          Float                 @default(0)
  paidLeaveDays       Float                 @default(0)
  unpaidLeaveDays     Float                 @default(0)
  overtimeHours       Float                 @default(0)
  overtimeAmount      Decimal               @default(0) @db.Decimal(12, 2)
  status              PayrollStatus         @default(DRAFT)
  paymentDate         DateTime?
  paymentMethod       String?
  transactionReference String?
  remarks             String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  schools             schools               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payroll_periods     payroll_periods       @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  employee_profiles   employee_profiles     @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  payroll_items       payroll_items[]
  payroll_adjustments payroll_adjustments[]
  payslips            payslips?

  @@unique([payrollPeriodId, employeeProfileId])
  @@index([schoolId])
  @@index([payrollPeriodId])
}

model payroll_items {
  id              String          @id @default(cuid())
  payrollRecordId String
  name            String
  type            ComponentType
  amount          Decimal         @default(0) @db.Decimal(12, 2)
  remarks         String?

  payroll_records payroll_records @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)

  @@index([payrollRecordId])
}

model payroll_adjustments {
  id              String          @id @default(cuid())
  schoolId        String
  payrollRecordId String
  type            ComponentType
  amount          Decimal         @default(0) @db.Decimal(12, 2)
  reason          String
  adjustedById    String
  createdAt       DateTime        @default(now())

  schools         schools         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payroll_records payroll_records @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)
  adjustedBy      users           @relation("PayrollAdjuster", fields: [adjustedById], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([payrollRecordId])
}

model payslips {
  id                String            @id @default(cuid())
  schoolId          String
  payrollRecordId   String            @unique
  employeeProfileId String
  payslipNumber     String            @unique
  month             Int
  year              Int
  grossSalary       Decimal           @db.Decimal(12, 2)
  totalDeductions   Decimal           @db.Decimal(12, 2)
  netSalary         Decimal           @db.Decimal(12, 2)
  paymentStatus     PayrollStatus     @default(APPROVED)
  generatedAt       DateTime          @default(now())
  fileUrl           String?

  schools           schools           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payroll_records   payroll_records   @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)
  employee_profiles employee_profiles @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([employeeProfileId])
}

model expense_categories {
  id          String       @id @default(cuid())
  schoolId    String
  name        String
  code        String?
  description String?
  budgetLimit Decimal?     @db.Decimal(12, 2)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  schools     schools      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  expenses    expenses[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model expenses {
  id                 String              @id @default(cuid())
  schoolId           String
  categoryId         String
  departmentId       String?
  createdById        String
  employeeProfileId  String?
  title              String
  description        String?
  amount             Decimal             @db.Decimal(12, 2)
  expenseDate        DateTime
  vendor             String?
  paymentMethod      String?
  receiptUrl         String?
  status             ExpenseStatus       @default(DRAFT)
  approvedById       String?
  approvedAt         DateTime?
  rejectionReason    String?
  paidAt             DateTime?
  paymentReference   String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  schools            schools             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  expense_categories expense_categories  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  departments        departments?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdBy          users               @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: Cascade)
  approvedBy         users?              @relation("ExpenseApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  employee_profiles  employee_profiles?  @relation(fields: [employeeProfileId], references: [id], onDelete: SetNull)
  expense_approvals  expense_approvals[]

  @@index([schoolId])
  @@index([categoryId])
  @@index([status])
}

model expense_approvals {
  id         String        @id @default(cuid())
  expenseId  String
  approverId String
  step       Int           @default(1)
  status     ExpenseStatus
  comment    String?
  actionDate DateTime      @default(now())

  expenses   expenses      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  approver   users         @relation("ExpenseStepApprover", fields: [approverId], references: [id], onDelete: Cascade)

  @@index([expenseId])
}

// ==========================================
// PHASE 9 ENUMS & MODELS: SAAS SUBSCRIPTION & BILLING
// ==========================================

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
}

enum PlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum BillingInvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  REFUNDED
}

enum BillingPaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum TrialStatus {
  NOT_STARTED
  ACTIVE
  EXPIRED
  CONVERTED
  CANCELLED
}

enum PaymentGatewayProvider {
  MOCK
  RAZORPAY
  STRIPE
}

model subscription_plans {
  id              String             @id @default(cuid())
  name            String
  code            String             @unique // FREE, BASIC, STANDARD, PREMIUM, ENTERPRISE
  description     String?
  monthlyPrice    Decimal            @db.Decimal(12, 2)
  quarterlyPrice  Decimal            @db.Decimal(12, 2)
  semiAnnualPrice Decimal            @db.Decimal(12, 2)
  annualPrice     Decimal            @db.Decimal(12, 2)
  currency        String             @default("USD")
  trialDays       Int                @default(14)
  isPopular       Boolean            @default(false)
  status          PlanStatus         @default(ACTIVE)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  plan_features        plan_features?
  school_subscriptions school_subscriptions[]
  billing_invoices     billing_invoices[]
}

model plan_features {
  id                String             @id @default(cuid())
  planId            String             @unique
  maxStudents       Int                @default(100) // -1 for unlimited
  maxStaff          Int                @default(20)  // -1 for unlimited
  maxStorageMb      Int                @default(1024)
  maxBranches       Int                @default(1)
  maxParentAccounts Int                @default(200) // -1 for unlimited
  allowedModules    String[]
  customLimits      Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  subscription_plans subscription_plans @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model school_subscriptions {
  id                    String                 @id @default(cuid())
  schoolId              String                 @unique
  planId                String
  billingCycle          BillingCycle           @default(MONTHLY)
  status                SubscriptionStatus     @default(TRIALING)
  trialStatus           TrialStatus            @default(ACTIVE)
  trialStartDate        DateTime?
  trialEndDate          DateTime?
  currentPeriodStart    DateTime               @default(now())
  currentPeriodEnd      DateTime
  nextBillingDate       DateTime?
  cancelAtPeriodEnd     Boolean                @default(false)
  cancelledAt           DateTime?
  suspendedAt           DateTime?
  gracePeriodEndDate    DateTime?
  autoRenew             Boolean                @default(true)
  gatewayProvider       PaymentGatewayProvider @default(MOCK)
  gatewaySubscriptionId String?
  gatewayCustomerId     String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  schools              schools                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subscription_plans   subscription_plans     @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscription_history subscription_history[]
  billing_invoices     billing_invoices[]
  payment_attempts     payment_attempts[]

  @@index([schoolId])
  @@index([planId])
  @@index([status])
}

model subscription_history {
  id             String                 @id @default(cuid())
  subscriptionId String
  schoolId       String
  action         String                 // CREATED, TRIAL_STARTED, ACTIVATED, UPGRADED, DOWNGRADED, RENEWED, PAST_DUE, GRACE_PERIOD, SUSPENDED, CANCELLED, REACTIVATED
  fromPlanId     String?
  toPlanId       String?
  fromStatus     SubscriptionStatus?
  toStatus       SubscriptionStatus
  reason         String?
  actorId        String?
  metadata       Json?
  createdAt      DateTime               @default(now())

  school_subscriptions school_subscriptions @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  schools              schools              @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([schoolId])
}

model subscription_coupons {
  id                String                 @id @default(cuid())
  code              String                 @unique
  name              String
  discountType      DiscountType           @default(PERCENTAGE)
  discountValue     Decimal                @db.Decimal(10, 2)
  maxDiscountAmount Decimal?               @db.Decimal(10, 2)
  minBillingAmount  Decimal?               @db.Decimal(10, 2)
  validFrom         DateTime               @default(now())
  validUntil        DateTime?
  maxUses           Int?
  usedCount         Int                    @default(0)
  maxUsesPerSchool  Int                    @default(1)
  applicablePlans   String[]               // Plan codes; empty = all
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  coupon_redemptions coupon_redemptions[]
}

model coupon_redemptions {
  id              String               @id @default(cuid())
  couponId        String
  schoolId        String
  invoiceId       String?
  discountApplied Decimal              @db.Decimal(12, 2)
  redeemedAt      DateTime             @default(now())

  subscription_coupons subscription_coupons @relation(fields: [couponId], references: [id], onDelete: Cascade)
  schools              schools              @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([schoolId])
}

model billing_addresses {
  id           String   @id @default(cuid())
  schoolId     String   @unique
  companyName  String
  taxId        String?  // GSTIN / VAT / EIN
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String   @default("IN")
  billingEmail String
  billingPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schools      schools  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model billing_invoices {
  id             String                 @id @default(cuid())
  schoolId       String
  subscriptionId String?
  planId         String?
  invoiceNumber  String                 @unique // e.g. INV-SAAS-2026-0001
  billingCycle   BillingCycle
  periodStart    DateTime
  periodEnd      DateTime
  subtotal       Decimal                @db.Decimal(12, 2)
  discountAmount Decimal                @default(0) @db.Decimal(12, 2)
  couponCode     String?
  taxPercentage  Decimal                @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal                @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal                @db.Decimal(12, 2)
  amountPaid     Decimal                @default(0) @db.Decimal(12, 2)
  balanceDue     Decimal                @db.Decimal(12, 2)
  currency       String                 @default("USD")
  status         BillingInvoiceStatus   @default(ISSUED)
  issueDate      DateTime               @default(now())
  dueDate        DateTime
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  schools              schools                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  school_subscriptions school_subscriptions?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  subscription_plans   subscription_plans?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  billing_invoice_items billing_invoice_items[]
  billing_payments     billing_payments[]
  credit_notes         credit_notes[]

  @@index([schoolId])
  @@index([subscriptionId])
  @@index([status])
}

model billing_invoice_items {
  id          String           @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int              @default(1)
  unitPrice   Decimal          @db.Decimal(12, 2)
  amount      Decimal          @db.Decimal(12, 2)
  itemType    String           // SUBSCRIPTION, ADDON, UPGRADE_PRORATION, DISCOUNT, TAX
  createdAt   DateTime         @default(now())

  billing_invoices billing_invoices @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model billing_payments {
  id                   String                 @id @default(cuid())
  schoolId             String
  invoiceId            String
  paymentNumber        String                 @unique // e.g. PAY-SAAS-2026-0001
  amount               Decimal                @db.Decimal(12, 2)
  currency             String                 @default("USD")
  gatewayProvider      PaymentGatewayProvider @default(MOCK)
  gatewayTransactionId String?
  gatewayPaymentId     String?
  status               BillingPaymentStatus   @default(PENDING)
  paidAt               DateTime?
  failureReason        String?
  receiptUrl           String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  schools          schools          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  billing_invoices billing_invoices @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([invoiceId])
  @@index([status])
}

model payment_attempts {
  id              String                 @id @default(cuid())
  subscriptionId  String
  schoolId        String
  invoiceId       String?
  attemptNumber   Int                    @default(1)
  status          BillingPaymentStatus
  gatewayProvider PaymentGatewayProvider
  errorMessage    String?
  attemptedAt     DateTime               @default(now())

  school_subscriptions school_subscriptions @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  schools              schools              @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([schoolId])
}

model payment_webhook_events {
  id              String                 @id @default(cuid())
  gatewayProvider PaymentGatewayProvider
  eventId         String                 @unique
  eventType       String
  payload         Json
  isProcessed     Boolean                @default(false)
  processedAt     DateTime?
  errorMessage    String?
  createdAt       DateTime               @default(now())

  @@index([eventId])
  @@index([isProcessed])
}

model credit_notes {
  id               String           @id @default(cuid())
  invoiceId        String
  schoolId         String
  creditNoteNumber String           @unique
  amount           Decimal          @db.Decimal(12, 2)
  reason           String
  issuedById       String
  issuedAt         DateTime         @default(now())

  billing_invoices billing_invoices @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  schools          schools          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  issuedBy         users            @relation("CreditNoteIssuer", fields: [issuedById], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([schoolId])
}



