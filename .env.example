# ==============================================================================
# SCHOOL ERP BACKEND CONFIGURATION TEMPLATE (.env.example)
# Phase 4.5 Staging / Production Environment Variables
# Copy to .env and replace placeholders with secure, environment-specific values.
# NEVER commit the real .env file with secrets into version control.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# Database Connection (PostgreSQL 14+)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
# Staging/Production: Use dedicated service account with SSL mode enabled (e.g., sslmode=require)
DATABASE_URL="postgresql://school_erp_user:CHANGE_ME_STRONG_DB_PASSWORD@localhost:5432/school_erp?schema=public&sslmode=prefer"

# Security & JSON Web Token Secrets
# Generate using cryptographically secure random bytes:
# Node.js: require('crypto').randomBytes(64).toString('hex')
JWT_SECRET="GENERATE_AND_PASTE_64_BYTE_HEX_JWT_ACCESS_SECRET"
JWT_ACCESS_EXPIRES_IN="15m"

# Optional JWT Refresh Secret (if secondary signing key is configured)
JWT_REFRESH_SECRET="GENERATE_AND_PASTE_64_BYTE_HEX_JWT_REFRESH_SECRET"
JWT_REFRESH_EXPIRES_IN="7d"

# Client CORS & Cookie Domain Allowlist
# Staging example: https://staging.schoolerp.com
# Production example: https://app.schoolerp.com
CLIENT_URL="http://localhost:3000"

# Local Storage Root Directory (Strictly restricted, no public HTTP access)
UPLOAD_DIR="uploads"

